# Copy to .env and replace the application digest after a trusted build or acquisition.
ANDREJA_IMAGE=andreja@sha256:REPLACE_WITH_64_HEX_DIGEST
ANDREJA_INSTANCE_NAME=local
ANDREJA_BIND_ADDRESS=127.0.0.1
ANDREJA_HTTP_PORT=8080
POSTGRES_DB=andreja
POSTGRES_USER=andreja
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
ANDREJA_BOOTSTRAP_TOKEN_FILE=./deploy/secrets/bootstrap_token
ANDREJA_HOSTNAME=localhost
ANDREJA_ASSISTANT_PROVIDER=deterministic
POSTGRES_MAINTENANCE_PORT=5432
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
