# Copy to .env and replace the application digest after a trusted build or acquisition.
ANDREJA_IMAGE=andreja@sha256:REPLACE_WITH_64_HEX_DIGEST
ANDREJA_INSTANCE_NAME=local
ANDREJA_BIND_ADDRESS=127.0.0.1
ANDREJA_HTTP_PORT=8080
POSTGRES_DB=andreja
POSTGRES_USER=andreja
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
ANDREJA_BOOTSTRAP_TOKEN_FILE=./deploy/secrets/bootstrap_token
ANDREJA_HOSTNAME=localhost
ANDREJA_PUBLIC_ORIGIN=https://localhost
# Exact source IP that Kestrel observes for the same-host TLS reverse proxy.
# Obtain it from the proxy/app network; never use 0.0.0.0, ::, or a CIDR range.
ANDREJA_TRUSTED_PROXY_IP=REPLACE_WITH_EXACT_PROXY_IP
ANDREJA_ASSISTANT_PROVIDER=deterministic
# BYOK values are used only with deploy/compose.byok.yaml. Never put the key here.
ANDREJA_ASSISTANT_ENDPOINT=https://provider.example/v1
ANDREJA_ASSISTANT_MODEL=operator-approved-model
ANDREJA_ASSISTANT_CREDENTIAL_FILE=./deploy/secrets/assistant_api_key
ANDREJA_ASSISTANT_TIMEOUT_SECONDS=30
ANDREJA_ASSISTANT_PROVIDER_DISCLOSURE=The selected provider receives submitted Open Loops request content.
ANDREJA_ASSISTANT_RETENTION_DISCLOSURE=Replace with the selected provider's reviewed retention terms.
ANDREJA_ASSISTANT_MAX_INPUT_UNITS=10000
ANDREJA_ASSISTANT_MAX_OUTPUT_UNITS=2000
ANDREJA_ASSISTANT_MAX_RESPONSE_BYTES=1048576
ANDREJA_ASSISTANT_MAX_RETRIES=2
ANDREJA_ASSISTANT_RETRY_BASE_DELAY_MS=100
# Keep zero unless Cyrus has approved and recorded a numeric external model-usage envelope.
ANDREJA_ASSISTANT_APPROVED_EXTERNAL_TOTAL_UNITS=0
POSTGRES_MAINTENANCE_PORT=5432
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
