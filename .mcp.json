{
  "mcpServers": {
    "squad_state": {
      "command": "npx",
      "args": [
        "-y",
        "@bradygaster/squad-cli@1.1.0",
        "state-mcp"
      ],
      "env": {
        "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org"
      },
      "tools": [
        "squad_decide",
        "squad_state_read",
        "squad_state_write",
        "squad_state_append",
        "squad_state_delete",
        "squad_state_list",
        "squad_state_health",
        "memory.classify",
        "memory.write",
        "memory.search",
        "memory.promote",
        "memory.delete",
        "memory.audit"
      ]
    }
  }
}
