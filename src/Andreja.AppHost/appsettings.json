{
  "Andreja": {
    "InstanceName": "local",
    "Operations": {
      "DataProtectionKeysPath": ".andreja/keys",
      "Database": {
        "Enabled": false,
        "Host": "localhost",
        "Port": 5432,
        "Name": "andreja",
        "Username": "andreja",
        "PasswordFile": ""
      }
    },
    "OpenLoops": {
      "Enabled": false,
      "PublicOrigin": "https://localhost:5001",
      "AssistantProvider": "deterministic"
    },
    "Identity": {
      "AuthenticationScheme": "Identity.Application",
      "RelyingPartyId": "localhost",
      "AllowedOrigins": [
        "https://localhost:5001"
      ],
      "BootstrapTokenFile": "C:\\run\\secrets\\andreja_bootstrap_token",
      "BootstrapTokenBytes": 32,
      "MaximumPasskeysPerUser": 10,
      "RecoveryCodeCount": 10,
      "RecoveryCodeLifetime": "90.00:00:00",
      "RecentAuthenticationWindow": "00:10:00",
      "RecoveryRateLimitAttempts": 5,
      "RecoveryRateLimitWindow": "00:15:00"
    },
    "Telemetry": {
      "Enabled": false,
      "ServiceName": "andreja",
      "OtlpEndpoint": "http://localhost:4317"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
