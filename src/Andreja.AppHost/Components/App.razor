<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Andreja.AppHost.styles.css"]" />
    <ImportMap AdditionalAttributes="@ImportMapAttributes" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["identity-passkeys.js"]" defer></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private IReadOnlyDictionary<string, object>? ImportMapAttributes =>
        HttpContext?.Items.TryGetValue("Andreja.CspNonce", out var nonce) == true
            ? new Dictionary<string, object>
            {
                ["nonce"] = nonce?.ToString() ?? string.Empty,
            }
            : null;
}
